# Airflow
AIRFLOW__API_AUTH__JWT_SECRET=replace-with-random-32-char-string
AIRFLOW_UID=50000

# Kaggle credentials — username from kaggle.com/[username], key from Settings > API > Create New Token
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-api-key-or-kgat-token

# DuckDB
DUCKDB_PATH=/opt/airflow/data/call_center.duckdb
